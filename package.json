{
  "name": "@statcord-ts/monorepo",
  "private": true,
  "workspaces": [
    "./packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown -W",
    "commit": "cz",
    "docs:dev": "vitepress dev docs",

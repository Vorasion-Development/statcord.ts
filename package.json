{
  "name": "@statcord-ts/monorepo",
  "private": true,
  "workspaces": [
    "./packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown -W",
    "commit": "cz",
    "docs:api": "typedoc && bun run move-api.ts",
    "docs:dev": "bun run docs:api && vitepress dev docs",
    "docs:build": "bun run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "husky",
    "test": "vitest --ui",
    "test:coverage": "vitest --ui --coverage"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@catppuccin/vitepress": "^0.1.4",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@sapphire/timestamp": "^1.0.5",
    "@shikijs/vitepress-twoslash": "^4.5.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "bumpp": "^12.3.0",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "inquirer": "9",
    "mermaid": "^12.2.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "publint": "^0.3.25",
    "socket": "^1.8.2",
    "taze": "^21.3.0",
    "tsdown": "^0.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-llms-txt": "^0.1.2",
    "typedoc-plugin-markdown": "^4.14.0",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "6",
    "vitepress": "^1.6.4",
    "vitepress-mermaid-viewer": "^0.5.1",
    "vitepress-plugin-group-icons": "^1.7.7",
    "vitest": "^5.0.4"
  }
}

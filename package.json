    "@commitlint/cz-commitlint": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@sapphire/timestamp": "^1.0.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.4",
    "@vitest/ui": "^5.0.4",
    "bumpp": "^12.3.0",
    "commitizen": "^4.3.2",
    "husky": "^9.1.7",
    "inquirer": "9",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "publint": "^0.3.25",
    "socket": "^1.8.2",
    "taze": "^21.3.0",
    "tsdown": "^0.23.1",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.4"
